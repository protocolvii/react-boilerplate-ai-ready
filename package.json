{
  "name": "react-boilerplate-ai-ready",
  "version": "0.1.0",
  "private": true,
  "description": "面向 AI 协作开发的 React 管理后台脚手架",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihahoo/react-boilerplate-ai-ready.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "clean": "rimraf build/static",
    "eslint": "eslint src vite tests vite.config.mjs",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "dev:mock": "vite --mode mock",
    "test:mock": "node --test tests/mock-api.test.mjs",
    "test:design": "node --test tests/appearance.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^9.0.1",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "hahoorequest": "^0.8.0",
    "immer": "^11.2.9",
    "localforage": "^1.10.0",
    "lucide-react": "^1.66.0",
    "md5": "^2.3.0",
    "moment": "^2.31.0",
    "next-themes": "^0.4.6",
    "query-string": "^10.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "redux": "^5.0.1",
    "redux-act-reducer": "^2.1.0",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
